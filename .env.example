# Database
DATABASE_URL=postgresql+asyncpg://postgres:1@localhost:5432/face_recognition

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=face_embeddings

# AI server
AI_SERVER_HOST=172.16.75.66
AI_SERVER_EMBED_PORT=8002
AI_SERVER_PREFIX=/api/v1
AI_SERVER_TIMEOUT=10

# Storage
IMAGE_STORAGE_PATH=./storage/images
RECOGNITION_LOGS_DIR=recognition_logs
VECTOR_SOURCES_DIR=vector_sources
UNKNOWN_QUEUE_DIR=unknown_queue
AVATARS_DIR=avatars
IMAGE_RETENTION_DAYS=7
IMAGE_CLEANUP_INTERVAL_HOURS=24
ADMIN_VECTOR_UPLOAD_LIMIT=5
IMAGE_PUBLIC_BASE=/media
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
BACKEND_CORS_ORIGIN_REGEX=https://.*\.ngrok-free\.app|https://.*\.ngrok\.app

# Email / SMTP
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Attendance System
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# Auth
SECRET_KEY=change-this-to-a-secure-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=1

# Thresholds
SURE_THRESHOLD=0.65
REVIEW_LOW=0.40
GAP_MIN=0.10
UPSERT_SCORE_MAX=0.80
UPSERT_MIN_VECS=5
DEDUP_THRESHOLD=0.45
RECOGNITION_LOG_COOLDOWN_MINUTES=15
EVENT_TABLET_LOOKAHEAD_MINUTES=60
